{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "description": "JSON schema to notify that an application failed to be added to the day list due to a system error.",
  "properties": {
    "data": {
      "$ref": "#/$defs/payload_data"
    }
  },
  "required": ["data"],
  "$defs": {
    "payload_data": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "required": ["status"]
    },
    "status": {
      "type": "string",
      "const": "SYSTEM_ERROR",
      "description": "The status of the application ."
    }
  }
}